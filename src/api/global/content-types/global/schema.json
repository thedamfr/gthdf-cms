{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Define global settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "siteDescription": {
      "type": "text",
      "required": true
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "llmsTxt": {
      "type": "text",
      "required": false
    },
    "gpxBuilderEnabled": {
      "type": "boolean",
      "required": true,
      "default": false,
      "info": {
        "description": "Active le Builder ville à ville uniquement lorsque tous les ancrages et jonctions publiés sont qualifiés."
      }
    },
    "publishCityItinerariesToNext": {
      "type": "boolean",
      "required": true,
      "default": false,
      "info": {
        "description": "Coupe-circuit global fail-closed du catalogue public d’itinéraires."
      }
    }
  }
}
