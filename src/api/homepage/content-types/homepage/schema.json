      "type": "string"
    },
    "horizons": {
      "type": "component",
      "component": "homepage.horizon-card",
      "repeatable": true
    },
    "rencontresTitre": {
      "type": "string"
    },
    "rencontres": {
      "type": "component",
      "component": "homepage.encounter-card",
      "repeatable": true
    },
    "mapTitle": {
      "type": "string"
    },
    "mapEmbedUrl": {
      "type": "text"
    },
    "mapCaption": {
      "type": "text"
    },
    "mapPreviewImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "principlesTitle": {
      "type": "string"
    },
    "principles": {
      "type": "component",
      "component": "homepage.principle-card",
      "repeatable": true
    },
    "introTitle": {
      "type": "string"
    },
    "introText": {
      "type": "text"
    },
    "faqTitle": {
      "type": "string"
    },
    "faqItems": {
      "type": "component",
      "component": "homepage.faq-item",
      "repeatable": true
    },
    "footerText": {
      "type": "text"
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
