{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "singularName": "chapter",
    "pluralName": "chapters",
    "displayName": "Chapter",
    "description": "A chapter of the route"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "startStation": {
      "type": "string",
      "required": true
    },
    "endStation": {
      "type": "string",
      "required": true
    },
    "distance": {
      "type": "integer",
      "required": true
    },
    "introSentence": {
      "type": "text",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "komootEmbedAB": {
      "type": "text"
    },
    "komootEmbedBA": {
      "type": "text"
    },
    "gpxFileAB": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "gpxFileBA": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "horizons": {
      "type": "component",
      "component": "homepage.horizon-card",
      "repeatable": true
    },
    "routeNotes": {
      "type": "richtext"
    },
    "testimonials": {
      "type": "component",
      "component": "shared.testimonial",
      "repeatable": true
    },
    "destination": {
      "type": "component",
      "component": "chapter.destination",
      "repeatable": false
    },
    "nextChapter": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::chapter.chapter"
    },
    "previousChapter": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::chapter.chapter"
    },
    "checkpoints": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::checkpoint.checkpoint",
      "mappedBy": "chapter"
    },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "relatedChapters"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "cities": {
      "type": "json",
      "info": {
        "description": "Liste des villes traversées pour le SEO local. Ex: [\"Lille\", \"Haubourdin\", \"Armentières\", \"Saint-Omer\"]"
      }
    }
  }
}
