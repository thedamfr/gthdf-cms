{
  "kind": "collectionType",
  "collectionName": "cities",
  "info": {
    "singularName": "city",
    "pluralName": "cities",
    "displayName": "Ville",
    "description": "Référentiel éditorial des villes traversées par le Grand Tour"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "alternativeNames": {
      "type": "json"
    },
    "municipalityKey": {
      "type": "string",
      "unique": true
    },
    "countryCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "regex": "^[A-Z]{2}$"
    },
    "municipalityCode": {
      "type": "string"
    },
    "administrativeArea": {
      "type": "string"
    },
    "latitude": {
      "type": "decimal",
      "min": -90,
      "max": 90
    },
    "longitude": {
      "type": "decimal",
      "min": -180,
      "max": 180
    },
    "coordinateSource": {
      "type": "json",
      "private": true
    },
    "shortDescription": {
      "type": "text"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.media",
        "shared.quote",
        "shared.rich-text",
        "shared.slider"
      ]
    },
    "hasPublicPage": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
